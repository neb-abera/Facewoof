# Copy to .env and fill in. Everything here has a working default for local
# development, so `make dev` needs no .env at all.

# ---- database ----
# compose sets this for the local containers. In production it is the only
# database setting that matters.
# DATABASE_URL=postgres://facewoof:facewoof@db:5432/facewoof

# Discrete settings, used when DATABASE_URL is not set.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=facewoof
# PGPASSWORD=facewoof
# PGDATABASE=facewoof

# Azure Database for PostgreSQL requires TLS. Leave unset locally.
# PGSSL=true

# ---- server ----
# Signs the session cookie. Required in production; the server refuses to start
# without it, because a generated per-process key would have replicas rejecting
# each other's cookies.
# SESSION_SECRET=

# Serves a production build over plain HTTP for testing: sends the session
# cookie without Secure, and drops upgrade-insecure-requests from the CSP so
# the bundle can load. Never set this on a deployed instance.
# INSECURE_TRANSPORT=true

# PORT=3001
# How long a demo account lives before the hourly sweep deletes it.
# GUEST_TTL_HOURS=24

# Demo sign-ins allowed per address per hour. Raised only for the browser
# tests, which all come from one address. Leave it alone in production.
# GUEST_LIMIT_PER_HOUR=10
# Only needed if the client is ever served from a different origin than the
# API. Comma separated. Unset means no cross-origin requests are allowed.
# CORS_ORIGIN=https://facewoof.abera.tech

# ---- client (baked into the bundle at build time) ----
# Set to /facewoof/ to serve the app under a path instead of at the root.
# VITE_BASE_PATH=/

# Cloudinary, for profile photo uploads. Without them the upload widget shows
# a note and the rest of the app works.
# VITE_CLOUD_NAME=
# VITE_UPLOAD_PRESET=
