# Copy to .env and fill in. Everything here has a working default for local
# development, so `make dev` needs no .env at all.
#
# `make` writes a .env with this copy's host ports the first time it runs
# (scripts/worktree-env.sh), and leaves an existing file alone. If you create
# .env by hand in a worktree, carry the port lines over so two copies of the
# repository do not collide:
# CLIENT_PORT=3000
# API_PORT=3001
# DB_PORT=5432
# APP_PORT=8080

# ---- database ----
# compose sets this for the local containers. In production it is the only
# database setting that matters.
# DATABASE_URL=postgres://facewoof:facewoof@db:5432/facewoof

# Discrete settings, used when DATABASE_URL is not set.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=facewoof
# PGPASSWORD=facewoof
# PGDATABASE=facewoof

# Azure Database for PostgreSQL requires TLS. Leave unset locally.
# PGSSL=true

# The server migrates the database when it starts, which means it connects as
# the role that owns the schema. Set to false once migrations run as their own
# step and the server connects as a role with no DDL rights
# (server/db/roles/runtime.sql, docs/DEPLOY.md); it then only checks nothing
# is pending, and refuses to start if something is.
# MIGRATE_ON_BOOT=false

# ---- server ----
# Signs the session cookie. Required in production; the server refuses to start
# without it, because a generated per-process key would have replicas rejecting
# each other's cookies. One key, or several separated by commas: the first
# signs, all verify, which is how a key is rotated without signing everyone
# out (docs/OPERATIONS.md).
# SESSION_SECRET=

# Serves a production build over plain HTTP for testing: sends the session
# cookie without Secure, and drops upgrade-insecure-requests from the CSP so
# the bundle can load. Never set this on a deployed instance.
# INSECURE_TRANSPORT=true

# PORT=3001

# How many reverse proxies sit in front of the server, for working out the
# caller's address (what the rate limits are keyed on). Default: 0 outside
# production, 1 in production. Production behind Cloudflare AND the Container
# Apps ingress is 2 — see docs/DEPLOY.md. Never set it higher than the number
# of proxies really there: the extra hop would be read from a header the
# caller controls.
# TRUST_PROXY_HOPS=2
# How long a demo account lives before the hourly sweep deletes it.
# GUEST_TTL_HOURS=24

# Demo sign-ins allowed per address per hour. Raised only for the browser
# tests, which all come from one address. Leave it alone in production.
# GUEST_LIMIT_PER_HOUR=10

# Requests per address per minute to each of the cheap anonymous routes
# (/api/auth/providers, which is also where the client fetches its CSRF token,
# sign-out, and the OIDC callback). Raised only for the browser tests, for the
# same reason as above. Leave it alone in production.
# PUBLIC_LIMIT_PER_MINUTE=60

# Feed reads (/api/discover) per address per minute. Raised only for the
# browser tests, whose specs together read the feed close to this many times
# from one address. Leave it alone in production.
# FEED_LIMIT_PER_MINUTE=60

# Demo accounts allowed to exist at once, across all addresses. Past it, demo
# sign-in answers 503 until the sweep frees room. Each account brings about a
# hundred roster rows with it.
# GUEST_MAX_LIVE=1000
# Only needed if the client is ever served from a different origin than the
# API. Comma separated. Unset means no cross-origin requests are allowed.
# CORS_ORIGIN=https://facewoof.abera.tech

# Signed photo uploads: with all three set, the server signs each upload and
# the unsigned preset below is not used. The secret is a server-side secret;
# never give it a VITE_ name. See docs/DEPLOY.md.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- client (baked into the bundle at build time) ----
# Set to /facewoof/ to serve the app under a path instead of at the root.
# VITE_BASE_PATH=/

# Cloudinary's UNSIGNED upload preset: the fallback while the signed settings
# above are absent. With neither, photo upload is hidden.
# VITE_CLOUD_NAME=
# VITE_UPLOAD_PRESET=

# Sign-in through Entra External ID, which fronts Google and Microsoft.
# Optional: leave these unset and the app runs on demo accounts alone, with no
# sign-in buttons shown.
ENTRA_ISSUER=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
