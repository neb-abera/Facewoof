{
  "name": "facewoof",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.ts",
    "server:dev": "node --watch server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.client.json",
    "openapi": "node server/api/openapi.ts",
    "generate:api-types": "tools/api-types/node_modules/.bin/openapi-typescript server/openapi.json --output src/api-types.d.ts",
    "check:contract": "scripts/check-contract.sh",
    "lint": "biome check .",
    "format": "biome check --write .",
    "migrate": "node server/db/migrate.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --coverage tests/unit",
    "test:db": "vitest run tests/db",
    "test:client": "vitest run --coverage --config vitest.client.config.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/monitor-opentelemetry": "^1.20.1",
    "@tanstack/react-query": "^5.104.3",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "lusca": "^1.7.0",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-calendar": "^6.0.1",
    "react-clock": "^6.0.0",
    "react-datetime-picker": "^7.1.0",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.18.4",
    "zipcodes": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lusca": "^1.7.5",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/zipcodes": "^8.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "daisyui": "^5.7.50",
    "fast-check": "4.10.2",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "0.145.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
